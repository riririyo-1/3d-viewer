# -- Docker Compose 用環境変数 --------------
# このファイルは compose.yaml 内の変数展開に使用される
# 各サービス固有の設定は server/.env, pipeline/.env, frontend/.env を参照

# -- PostgreSQL --------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=studio_view

# -- MinIO --------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
